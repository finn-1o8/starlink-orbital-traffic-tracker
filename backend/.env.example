# Copy to .env and adjust. Every value has a sensible default except DATABASE_URL in production.

# PostgreSQL connection string. Unset -> a local SQLite file is used (development only).
DATABASE_URL=postgresql://orbital_user:change-me@localhost:5432/orbital_tracker

# Redis cache. Unreachable Redis just disables caching.
REDIS_URL=redis://localhost:6379/0

# Browser origins allowed to call the API and open the WebSocket (comma separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Refresh the Starlink catalogue from CelesTrak every N hours.
TLE_UPDATE_INTERVAL_HOURS=6

# How often positions are recomputed and pushed to WebSocket clients.
WS_UPDATE_SECONDS=5

# How long computed positions stay in Redis.
POSITION_CACHE_SECONDS=30

# Background jobs and the WebSocket broadcaster can be switched off (tests do this).
SCHEDULER_ENABLED=true
WS_BROADCAST_ENABLED=true

API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
