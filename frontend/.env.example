# Copy to .env for local development. All values are optional.

# Backend location. Defaults: http://localhost:8000/api in development, /api in production builds.
VITE_API_URL=http://localhost:8000/api
# WebSocket base. Defaults to the API host with ws:// or wss://.
VITE_WS_URL=ws://localhost:8000/api

# Cesium ion token (https://ion.cesium.com). Optional: without it the globe uses OpenStreetMap
# tiles and no terrain. Restrict the token to your domain in the Cesium ion dashboard.
VITE_CESIUM_ION_TOKEN=

# Optional link shown in the header, for embedding the tracker in a larger site.
VITE_LANDING_URL=
