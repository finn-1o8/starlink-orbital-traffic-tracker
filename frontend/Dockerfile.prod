# Production image: static build served by nginx.
#
#   docker build -f Dockerfile.prod --build-arg CESIUM_ION_TOKEN=... -t tracker-frontend .
#
# CESIUM_ION_TOKEN is optional (without it the globe uses OpenStreetMap tiles, no terrain).
# LANDING_URL is optional and adds a "Back" link to a parent site.

FROM node:26-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

ARG CESIUM_ION_TOKEN=
ARG LANDING_URL=
ENV VITE_API_URL=/api
ENV VITE_CESIUM_ION_TOKEN=${CESIUM_ION_TOKEN}
ENV VITE_LANDING_URL=${LANDING_URL}

RUN npm run build

FROM nginx:1.27-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
